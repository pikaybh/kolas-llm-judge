# OpenAI Judge
OPENAI_API_KEY=
JUDGE_MODEL=gpt-5.6-sol
JUDGE_REASONING_EFFORT=medium
JUDGE_MAX_PAIRS_PER_CALL=120

# SEEXR production SUT.
SEEXR_API_BASE_URL=https://api.seexr.dev/api
SEEXR_AGENT_ID=risk-assessment
SEEXR_RISK_ASSESSMENT_METHOD=빈도강도법 5x4
SEEXR_MODEL_MODE=fast
SEEXR_REASONING_STYLE=balanced
SEEXR_TIMEOUT_SECONDS=180
SEEXR_MAX_RETRIES=3
SEEXR_RETRY_BACKOFF_SECONDS=0.5

# Option A: short-lived token (development/smoke only; not renewable by the harness).
SEEXR_API_TOKEN=

# Option B: dedicated NON-ADMIN evaluation account (required for official pilot/full).
# Access tokens are refreshed automatically in memory; refresh tokens are never persisted.
# Admin accounts require MFA and are intentionally not supported for automation.
SEEXR_EMAIL=
SEEXR_PASSWORD=
