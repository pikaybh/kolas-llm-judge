# OpenAI Judge
# Official KOLAS runs ignore model/concurrency/runtime overrides below and use configs/official_runtime_v1.yaml.
# These values are for development/benchmark commands; credentials are still read from .env.
OPENAI_API_KEY=
JUDGE_MODEL=gpt-5.6-sol
JUDGE_REASONING_EFFORT=medium
JUDGE_MAX_PAIRS_PER_CALL=80
JUDGE_MAX_CONCURRENCY=3
JUDGE_TIMEOUT_SECONDS=300
JUDGE_MAX_RETRIES=3
BINARY_JUDGE_MAX_CONCURRENCY=12
BINARY_JUDGE_TIMEOUT_SECONDS=180
BINARY_JUDGE_MAX_RETRIES=3
OFFICIAL_CASE_CONCURRENCY=24
OFFICIAL_SUT_CONCURRENCY=6
BINARY_MATCH_CHUNK_SIZE=80
BINARY_QUALITY_CHUNK_SIZE=40
BINARY_SAFETY_CHUNK_SIZE=50

# SEEXR production SUT.
SEEXR_API_BASE_URL=https://api.seexr.dev/api
SEEXR_AGENT_ID=risk-assessment
SEEXR_RISK_ASSESSMENT_METHOD="빈도강도법 5x4"
SEEXR_MODEL_MODE=fast
SEEXR_REASONING_STYLE=balanced
SEEXR_TIMEOUT_SECONDS=180
SEEXR_MAX_RETRIES=3
SEEXR_RETRY_BACKOFF_SECONDS=0.5

# Preferred: revocable scoped SEEXR developer API key (provisioned separately).
# Must belong to the exact environment specified in configs/official_runtime_v1.yaml.
SEEXR_API_KEY=

# Legacy option: short-lived JWT (development/smoke only).
SEEXR_API_TOKEN=

# Option B: dedicated NON-ADMIN evaluation account (required for official pilot/full).
# Access tokens are refreshed automatically in memory; refresh tokens are never persisted.
# Admin accounts require MFA and are intentionally not supported for automation.
SEEXR_EMAIL=
SEEXR_PASSWORD=
